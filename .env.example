# Resend (contact + devis forms). Without this set, form submissions are
# logged to the server console instead of sending an email — the site still
# builds and works.
RESEND_API_KEY=
RESEND_TO_EMAIL=info@elmaservices.com

# Sanity (réalisations / actualités CMS) — filled in during the follow-up
# iteration once a Sanity project has been created.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
